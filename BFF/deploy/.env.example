# Copy this file to deploy/.env and fill in the real values. deploy/.env is gitignored (*.env) and
# must never be committed.
#
# VAULT_ROLE_ID/VAULT_SECRET_ID are NOT set here — they come from GitHub Secrets (Environment dev/prod)
# and are injected by .github/workflows/deploy-dev.yml at deploy time, not stored in this file on the
# server. See docs/VAULT_MIGRATION.md.

# --- ASP.NET Core -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Database -----------------------------------------------------------------
# The database itself is not created by this service — see deploy/migration/.
DB_HOST=tf-postgres
DB_PORT=5432
DB_NAME=tf
DB_USER=bff_user
# DB_PASSWORD is NOT set here — it comes from Vault at container start (secret/tf/postgres/bff,
# key TF_PG_BFF_USER_PASSWORD), wired via docker-compose.yml's VAULT_EXPAND. See docs/VAULT_MIGRATION.md.
# All BFF entities live in this schema (section 5) — set via Npgsql's Search Path, never hardcoded
# in the EF model or in migrations.
DB_SCHEMA=bff
DB_MAX_POOL_SIZE=50

# --- Auth service -------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8080
AUTH_REFRESH_PATH=/api/auth/refresh
AUTH_REFRESH_TIMEOUT_SECONDS=5
AUTH_JWKS_URL=http://auth-service:8080/.well-known/jwks.json
AUTH_JWKS_CACHE_MINUTES=60
AUTH_ISSUER=https://auth.example.local
AUTH_AUDIENCE=think-front
AUTH_ACCESS_TOKEN_COOKIE=access_token
AUTH_USER_ID_CLAIM=sub

# --- RBAC cache -----------------------------------------------------------------
PERMISSIONS_CACHE_TTL_SECONDS=300
RBAC_VERSION_POLL_SECONDS=5

# --- CORS / logging -------------------------------------------------------------
# Comma-separated list of allowed origins; empty disables CORS entirely.
CORS_ALLOWED_ORIGINS=https://app.example.local
LOG_LEVEL=Information

# --- Email (POST /notifications/email) -----------------------------------------
SMTP_HOST=tf-mail
SMTP_PORT=25
SMTP_FROM=bff@think-front.local
# SMTP_USER/SMTP_PASSWORD — не задавай, если сервер принимает почту без авторизации (обычно так для
# контейнера внутри своей docker-сети). Если нужна авторизация — пароль клади через Vault, тем же
# способом, что и DB_PASSWORD (см. docs/VAULT_MIGRATION.md), а не сюда открытым текстом.
# SMTP_USER=
# SMTP_USE_SSL=false
