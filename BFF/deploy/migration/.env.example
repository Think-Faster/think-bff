# Copy to deploy/migration/.env. Gitignored (*.env); never commit the real file.
#
# DB_MIGRATION_USER/DB_MIGRATION_PASSWORD ideally has CREATE on the target database, so entrypoint.sh can
# create DB_SCHEMA if it's missing. If your schemas are provisioned by infra ahead of time instead (and
# the migration user intentionally has no CREATE on the database — only rights inside the already-existing
# schema), set DB_SKIP_SCHEMA_CREATE=true below: CREATE SCHEMA IF NOT EXISTS still requires CREATE on the
# database just to attempt the statement, so without this flag it fails even though the schema is already
# there.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=thinkfront
DB_SCHEMA=bff

DB_MIGRATION_USER=bff_migrator
DB_MIGRATION_PASSWORD=

# true if the schema already exists and DB_MIGRATION_USER has no CREATE on the database.
DB_SKIP_SCHEMA_CREATE=false

DOCKER_NETWORK=app-network
