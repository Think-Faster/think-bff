# Copy to deploy/migration/.env. Gitignored (*.env); never commit the real file.
#
# Инфраструктура заводит базу, схему bff, роли bff_admin/bff_user и права заранее (docs/VAULT_MIGRATION.md
# §5) — bff_admin владеет схемой (может создавать/менять таблицы внутри неё), но CREATE на самой базе у
# него нет и не будет — это архитектурное решение инфраструктуры, не настройка конкретного стенда. Поэтому
# DB_SKIP_SCHEMA_CREATE больше не здесь: зашит как true прямо в docker-compose.migrations.yml, чтобы не
# зависеть от того, что прописано в этом файле на конкретном сервере (см. docs/DECISIONS.md).
#
# VAULT_ROLE_ID/VAULT_SECRET_ID and DB_MIGRATION_PASSWORD are NOT set here — see
# docs/VAULT_MIGRATION.md. VAULT_ROLE_ID/VAULT_SECRET_ID come from GitHub Secrets (injected by
# .github/workflows/run-bff-migrations.yml and deploy-dev.yml); DB_MIGRATION_PASSWORD is filled in at
# container start from Vault (secret/tf/postgres/bff, key TF_PG_BFF_ADMIN_PASSWORD).

DB_HOST=tf-postgres
DB_PORT=5432
DB_NAME=tf
DB_SCHEMA=bff

DB_MIGRATION_USER=bff_admin
