# Copy to deploy/migration/.env. Gitignored (*.env); never commit the real file.
#
# DB_MIGRATION_USER/DB_MIGRATION_PASSWORD must be a role with CREATE on the target database (it creates
# DB_SCHEMA if missing) — the application's own runtime user (deploy/.env) must NOT have that right.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=thinkfront
DB_SCHEMA=bff

DB_MIGRATION_USER=bff_migrator
DB_MIGRATION_PASSWORD=

DOCKER_NETWORK=app-network
